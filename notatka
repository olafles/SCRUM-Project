```c
void gameLoop(void) {
    uint32_t frame_start = HAL_GetTick();

    // 1) Get accelerometer direction
    Dir direction = GetDirection();

    // 2) If a valid direction is detected, move Pac-Man
    if (direction != DIR_NONE) {
        DoMove(direction);  // Move Pac-Man in the detected direction
    }

    // 3) Wait for next frame to maintain the game loop at a stable rate
    uint32_t now_ms = HAL_GetTick();
    uint32_t elapsed = now_ms - frame_start;
    if (elapsed < FRAME_MS_TARGET) {
        HAL_Delay(FRAME_MS_TARGET - elapsed);
    }

    // Additional game logic, AI for Pinky, freeze conditions, etc.
    pinky_timer_ms += g_frame_ms;
    while (pinky_timer_ms >= 500U) {
        movePinky();
        pinky_timer_ms -= 500U;
    }

